{
  "name": "claude2gemini-cli",
  "version": "0.6.0",
  "description": "Claude API compatible proxy backed by Gemini CLI SDK",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc && cp server/mcp-proxy.mjs dist/server/mcp-proxy.mjs",
    "start": "node dist/server/index.js",
    "account:add": "tsx cli/manage-accounts.ts add",
    "account:list": "tsx cli/manage-accounts.ts list",
    "account:remove": "tsx cli/manage-accounts.ts remove",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "dependencies": {
    "antigravity-client": "file:./antigravity-client",
    "express": "^5.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.20.3",
    "typescript": "^5.3.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
